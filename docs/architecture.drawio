x=0;exitDy=0;exitPerimeter=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="929" y="206" /></Array></mxGeometry></mxCell><mxCell id="aws-infer-46" edge="1" parent="aws-infer-online" source="aws-infer-32" target="aws-infer-34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="aws-infer-47" edge="1" parent="aws-infer-online" source="aws-infer-34" target="aws-infer-16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0.25;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1359" y="400" /><mxPoint x="1230" y="400" /></Array></mxGeometry></mxCell><mxCell id="aws-infer-48" edge="1" parent="aws-infer-online" source="aws-infer-34" target="aws-infer-37" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0.75;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1398" y="400" /><mxPoint x="1450" y="400" /></Array></mxGeometry></mxCell><mxCell id="aws-infer-batch" parent="aws-infer-0" value="aws-infer-batch" /><mxCell id="aws-infer-49" parent="aws-infer-batch" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=default;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;labelBackgroundColor=none;fontFamily=Verdana;dashed=1;dashPattern=8 8;" value="Demand Forecasting&lt;br&gt;Batch" vertex="1"><mxGeometry x="140" y="660" width="1400" height="240" as="geometry" /></mxCell><mxCell id="aws-infer-50" parent="aws-infer-batch" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;fontFamily=Verdana;" value="Schedule diario" vertex="1"><mxGeometry x="240" y="760" width="78" height="78" as="geometry" /></mxCell><mxCell id="aws-infer-51" parent="aws-infer-batch" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➊&lt;/font&gt;" vertex="1"><mxGeometry x="310" y="730" width="48" height="52" as="geometry" /></mxCell><mxCell id="aws-infer-52" parent="aws-infer-batch" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fontFamily=Verdana;" value="BatchScoring&lt;br&gt;Lambda" vertex="1"><mxGeometry x="560" y="760" width="78" height="78" as="geometry" /></mxCell><mxCell id="aws-infer-53" parent="aws-infer-batch" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➋&lt;/font&gt;" vertex="1"><mxGeometry x="630" y="730" width="48" height="52" as="geometry" /></mxCell><mxCell id="aws-infer-54" parent="aws-infer-batch" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sagemaker;fontFamily=Verdana;" value="Batch Transform" vertex="1"><mxGeometry x="871" y="760" width="78" height="78" as="geometry" /></mxCell><mxCell id="aws-infer-55" parent="aws-infer-batch" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➐&lt;/font&gt;" vertex="1"><mxGeometry x="941" y="730" width="48" height="52" as="geometry" /></mxCell><mxCell id="aws-infer-56" parent="aws-infer-batch" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;fontFamily=Verdana;" value="Regla de fallo&lt;br&gt;del Transform" vertex="1"><mxGeometry x="1191" y="760" width="78" height="78" as="geometry" /></mxCell><mxCell id="aws-infer-57" parent="aws-infer-batch" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➒&lt;/font&gt;" vertex="1"><mxGeometry x="1261" y="730" width="48" height="52" as="geometry" /></mxCell><mxCell id="aws-infer-58" edge="1" parent="aws-infer-batch" source="aws-infer-50" target="aws-infer-52" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="aws-infer-59" edge="1" parent="aws-infer-batch" source="aws-infer-52" target="aws-infer-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0.75;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="618" y="620" /><mxPoint x="520" y="620" /><mxPoint x="520" y="509" /></Array></mxGeometry></mxCell><mxCell id="aws-infer-60" edge="1" parent="aws-infer-batch" source="aws-infer-52" target="aws-infer-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0.25;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="579" y="640" /><mxPoint x="480" y="640" /><mxPoint x="480" y="509" /></Array></mxGeometry></mxCell><mxCell id="aws-infer-61" edge="1" parent="aws-infer-batch" source="aws-infer-5" target="aws-infer-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="aws-infer-62" edge="1" parent="aws-infer-batch" source="aws-infer-52" target="aws-infer-54" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="aws-infer-63" edge="1" parent="aws-infer-batch" source="aws-infer-54" target="aws-infer-12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0.75;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="700" /><mxPoint x="970" y="700" /><mxPoint x="970" y="528" /></Array></mxGeometry></mxCell><mxCell id="aws-infer-64" edge="1" parent="aws-infer-batch" source="aws-infer-54" target="aws-infer-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0;exitY=0.9;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="830" /><mxPoint x="840" y="940" /><mxPoint x="90" y="940" /><mxPoint x="90" y="509" /></Array></mxGeometry></mxCell><mxCell id="aws-infer-65" edge="1" parent="aws-infer-batch" source="aws-infer-20" target="aws-infer-54" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="870" /><mxPoint x="980" y="870" /><mxPoint x="980" y="818" /></Array></mxGeometry></mxCell><mxCell id="aws-infer-66" edge="1" parent="aws-infer-batch" source="aws-infer-54" target="aws-infer-56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="aws-infer-67" edge="1" parent="aws-infer-batch" source="aws-infer-56" target="aws-infer-16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="799" /><mxPoint x="1300" y="509" /></Array></mxGeometry></mxCell><mxCell id="aws-infer-info" parent="aws-infer-0" value="aws-infer-info" /><mxCell id="aws-infer-68" parent="aws-infer-info" style="text;html=1;spacing=20;spacingTop=-30;whiteSpace=wrap;overflow=hidden;rounded=1;fontSize=12;fontFamily=Helvetica;fillColor=#7EA6E0;strokeColor=none;arcSize=4;glass=0;shadow=0;opacity=25;" value="&lt;h1 style=&quot;line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 18px;&quot;&gt;Flujo de inferencia en AWS&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;text-align: justify; line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;p&gt;Cómo se sirven los modelos aprobados: online, con una API HTTP respaldada por un endpoint en tiempo real monitoreado (stack &lt;b&gt;Endpoint&lt;/b&gt;), y en batch, para pronosticar los últimos días y medir el error real (stack &lt;b&gt;Batch&lt;/b&gt;). Ambos usan solo modelos que una persona aprobó, leídos del contrato de despliegue que escribe el flujo de entrenamiento.&lt;/p&gt;&lt;p&gt;Online, un &lt;b&gt;Sistema cliente&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➊&lt;/font&gt; llama a la &lt;b&gt;HTTP API&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➋&lt;/font&gt;, abierta a cualquiera (sin autenticación, es un proyecto de aprendizaje) pero limitada a un número de peticiones por segundo. La &lt;b&gt;Lambda Predict&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➌&lt;/font&gt; valida las horas de la petición, calcula las features de calendario a partir de cada timestamp y las envía, en el orden exacto de columnas que espera el modelo, al &lt;b&gt;SageMaker Endpoint&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➍&lt;/font&gt;, devolviendo la demanda pronosticada de cada hora.&lt;/p&gt;&lt;p&gt;El endpoint se crea a partir del &lt;b&gt;Contrato de despliegue (SSM)&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➎&lt;/font&gt; cuando se despliega su stack: liberar una versión recién aprobada es redesplegar ese stack, que mueve el tráfico al modelo nuevo con una actualización blue/green y vuelve atrás sola si aparecen errores. Corre la imagen de esa versión del &lt;b&gt;Repositorio de imagen del modelo&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➏&lt;/font&gt; en una sola instancia pequeña.&lt;/p&gt;&lt;p&gt;El endpoint copia peticiones y respuestas al &lt;b&gt;Bucket de artefactos&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➐&lt;/font&gt;. Cada día la &lt;b&gt;Lambda DataDrift&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➑&lt;/font&gt; lee el tráfico capturado en las 24 horas anteriores, compara la temperatura, los lags de demanda y la media semanal con el perfil de referencia calculado al entrenar el modelo (Population Stability Index) y escribe un reporte de drift; las features de calendario se dejan fuera porque solo reflejan qué horas se pidieron. Las &lt;b&gt;Alarmas de CloudWatch&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➒&lt;/font&gt; vigilan los errores del endpoint, su latencia y el drift medido y avisan al &lt;b&gt;Tópico de notificaciones&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➓&lt;/font&gt;; la alarma de drift también llega a los &lt;b&gt;Disparadores de entrenamiento&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;⓫&lt;/font&gt;, que lanzan un reentrenamiento.&lt;/p&gt;&lt;p&gt;En batch, el &lt;b&gt;Schedule diario&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➊&lt;/font&gt; (solo en producción) ejecuta la &lt;b&gt;Lambda BatchScoring&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➋&lt;/font&gt;, que lee el modelo aprobado del &lt;b&gt;Contrato de despliegue (SSM)&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt; y le pide a &lt;b&gt;Athena&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➍&lt;/font&gt; exportar la última semana de los últimos datos curados del &lt;b&gt;Bucket Data Lake&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➎&lt;/font&gt; al &lt;b&gt;Bucket de artefactos&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➏&lt;/font&gt;.&lt;/p&gt;&lt;p&gt;Luego arranca un job de &lt;b&gt;Batch Transform&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➐&lt;/font&gt; con el modelo aprobado, que corre su imagen del &lt;b&gt;Repositorio de imagen del modelo&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➑&lt;/font&gt;, pronostica cada hora sin enviarle el timestamp al modelo, vuelve a unir el timestamp y escribe los pronósticos en la zona de predicciones del data lake. Ahí Athena los compara con la demanda real para reportar el error diario del modelo en producción. Si el job falla, la &lt;b&gt;Regla de fallo del Transform&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➒&lt;/font&gt; avisa al &lt;b&gt;Tópico de notificaciones&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➓&lt;/font&gt;.&lt;/p&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="1900" y="40" width="720" height="610" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>