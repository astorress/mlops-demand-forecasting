d;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="run_drift_detection&lt;br&gt;(Evidently)" vertex="1"><mxGeometry x="660" y="730" width="72" height="72" as="geometry" /></mxCell><mxCell id="os-serve-32" parent="os-serve-monitoring" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➍&lt;/font&gt;" vertex="1"><mxGeometry x="730" y="700" width="48" height="52" as="geometry" /></mxCell><mxCell id="os-serve-33" parent="os-serve-monitoring" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Verdana;fontSize=11;fontColor=#232F3E;" value="check_drift&lt;br&gt;¿score sobre&lt;br&gt;el umbral?" vertex="1"><mxGeometry x="881" y="727" width="110" height="78" as="geometry" /></mxCell><mxCell id="os-serve-34" parent="os-serve-monitoring" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➏&lt;/font&gt;" vertex="1"><mxGeometry x="970" y="697" width="48" height="52" as="geometry" /></mxCell><mxCell id="os-serve-35" parent="os-serve-monitoring" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="mlops_retraining&lt;br&gt;DAG" vertex="1"><mxGeometry x="1160" y="730" width="72" height="72" as="geometry" /></mxCell><mxCell id="os-serve-36" parent="os-serve-monitoring" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➐&lt;/font&gt;" vertex="1"><mxGeometry x="1230" y="700" width="48" height="52" as="geometry" /></mxCell><mxCell id="os-serve-37" parent="os-serve-monitoring" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=default;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=34;spacingTop=-2;fontSize=12;fontColor=#232F3E;fontFamily=Verdana;container=0;collapsible=0;" value="./data&lt;br&gt;(bind mount)" vertex="1"><mxGeometry x="360" y="960" width="230" height="190" as="geometry" /></mxCell><mxCell id="os-serve-38" parent="os-serve-monitoring" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="" vertex="1"><mxGeometry x="366" y="964" width="24" height="24" as="geometry" /></mxCell><mxCell id="os-serve-39" parent="os-serve-monitoring" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#E6E6E6;strokeColor=#666666;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=nowrap;" value="CSV raw +&lt;br&gt;split de train" vertex="1"><mxGeometry x="510" y="1020" width="60" height="72" as="geometry" /></mxCell><mxCell id="os-serve-40" parent="os-serve-monitoring" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt;" vertex="1"><mxGeometry x="570" y="990" width="48" height="52" as="geometry" /></mxCell><mxCell id="os-serve-41" parent="os-serve-monitoring" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=default;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=34;spacingTop=-2;fontSize=12;fontColor=#232F3E;fontFamily=Verdana;container=0;collapsible=0;" value="./artifacts&lt;br&gt;(bind mount)" vertex="1"><mxGeometry x="640" y="960" width="230" height="190" as="geometry" /></mxCell><mxCell id="os-serve-42" parent="os-serve-monitoring" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="" vertex="1"><mxGeometry x="646" y="964" width="24" height="24" as="geometry" /></mxCell><mxCell id="os-serve-43" parent="os-serve-monitoring" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#E6E6E6;strokeColor=#666666;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=nowrap;" value="Reporte HTML&lt;br&gt;de drift" vertex="1"><mxGeometry x="750" y="1020" width="60" height="72" as="geometry" /></mxCell><mxCell id="os-serve-44" parent="os-serve-monitoring" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➎&lt;/font&gt;" vertex="1"><mxGeometry x="810" y="990" width="48" height="52" as="geometry" /></mxCell><mxCell id="os-serve-45" edge="1" parent="os-serve-monitoring" source="os-serve-27" target="os-serve-29" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="os-serve-46" edge="1" parent="os-serve-monitoring" source="os-serve-29" target="os-serve-39" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.85;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="791" /></Array></mxGeometry></mxCell><mxCell id="os-serve-47" edge="1" parent="os-serve-monitoring" source="os-serve-29" target="os-serve-31" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="os-serve-48" edge="1" parent="os-serve-monitoring" source="os-serve-31" target="os-serve-43" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.85;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="791" /></Array></mxGeometry></mxCell><mxCell id="os-serve-49" edge="1" parent="os-serve-monitoring" source="os-serve-31" target="os-serve-33" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="os-serve-50" edge="1" parent="os-serve-monitoring" source="os-serve-33" target="os-serve-35" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="os-serve-51" edge="1" parent="os-serve-monitoring" source="os-serve-35" target="os-serve-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1196" y="600" /><mxPoint x="730" y="600" /></Array></mxGeometry></mxCell><mxCell id="os-serve-info" parent="os-serve-0" value="os-serve-info" /><mxCell id="os-serve-52" parent="os-serve-info" style="text;html=1;spacing=20;spacingTop=-30;whiteSpace=wrap;overflow=hidden;rounded=1;fontSize=12;fontFamily=Helvetica;fillColor=#7EA6E0;strokeColor=none;arcSize=4;glass=0;shadow=0;opacity=25;" value="&lt;h1 style=&quot;line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 18px;&quot;&gt;Flujo de serving y monitoreo open source&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;text-align: justify; line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;p&gt;Cómo se sirve y se vigila el modelo champion en tu máquina: una API HTTP para pronósticos online y un DAG diario de Airflow que busca data drift y reentrena cuando lo encuentra. Ambos leen el modelo que promovió el flujo de entrenamiento.&lt;/p&gt;&lt;p&gt;Un &lt;b&gt;Sistema cliente&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➊&lt;/font&gt; envía las features de una o más horas a la &lt;b&gt;API Flask&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➋&lt;/font&gt;, que las valida, agrega los mismos encodings cíclicos del entrenamiento y devuelve la demanda pronosticada. Como alternativa, &lt;b&gt;MLflow Serve&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➌&lt;/font&gt; expone el mismo modelo con el protocolo de scoring estándar de MLflow. Ambos cargan la versión con el alias champion del &lt;b&gt;Model Registry&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➍&lt;/font&gt; y sus archivos del &lt;b&gt;volumen de artefactos&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➎&lt;/font&gt;; ninguno guarda las peticiones, así que el monitoreo trabaja sobre los datos mismos.&lt;/p&gt;&lt;p&gt;Cada mañana el &lt;b&gt;DAG mlops_monitoring&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➊&lt;/font&gt; corre &lt;b&gt;load_recent_data&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➋&lt;/font&gt;, que toma los últimos siete días de la serie raw de la &lt;b&gt;carpeta de datos&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt;. &lt;b&gt;run_drift_detection&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➍&lt;/font&gt; los compara con el split de entrenamiento usando los presets de data drift y data quality de Evidently y guarda un &lt;b&gt;reporte HTML de drift&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➎&lt;/font&gt;.&lt;/p&gt;&lt;p&gt;&lt;b&gt;check_drift&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➏&lt;/font&gt; decide según el score de drift: bajo el umbral solo registra que todo está bien; sobre él, dispara el &lt;b&gt;DAG mlops_retraining&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➐&lt;/font&gt; sin esperarlo. Ese DAG repite el preprocesamiento, la búsqueda de hiperparámetros, el entrenamiento y la comparación con el champion, y promueve el modelo nuevo en el &lt;b&gt;Model Registry&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➑&lt;/font&gt; solo si es mejor. La API toma el nuevo champion la próxima vez que carga el modelo.&lt;/p&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="1480" y="40" width="680" height="430" as="geometry" /></mxCell></root></mxGraphModel></diagram>
