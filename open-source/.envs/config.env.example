# =============================================================================
# MLOps Demand Forecasting - Variables de entorno
# `make setup` copia este archivo a .envs/config.env, pone tu UID en AIRFLOW_UID y genera las claves de Airflow.
# Todas tienen valor por defecto en docker-compose.yml: solo cambia lo que necesites.
# =============================================================================

# --- Airflow ---
# UID con el que corre Airflow, para que pueda escribir en data/ y artifacts/
AIRFLOW_UID=50000
# Claves de la instancia local: `make setup` genera valores aleatorios al crear .envs/config.env.
# Fernet key manual: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=

# --- PostgreSQL ---
# Base de datos compartida: metadata de Airflow y backend store de MLflow
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops_secret
POSTGRES_DB_AIRFLOW=airflow
POSTGRES_DB_MLFLOW=mlflow

# --- MLflow ---
MLFLOW_EXPERIMENT_NAME=demand_forecasting
MLFLOW_MODEL_NAME=demand_forecaster

# --- Monitoreo ---
# Umbral de drift para disparar el reentrenamiento
DRIFT_THRESHOLD=0.2

# --- Puertos publicados en tu máquina ---
# MLflow usa 5050 porque en macOS el 5000 lo ocupa AirPlay Receiver
MLFLOW_PORT=5050
AIRFLOW_PORT=8080
JUPYTER_PORT=8888
FLASK_PORT=8000

# --- AWS SageMaker (solo para src/serving/sagemaker_deploy.py) ---
AWS_REGION=us-east-1
SAGEMAKER_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/SageMakerExecutionRole
SAGEMAKER_ENDPOINT_NAME=demand-forecaster-endpoint
